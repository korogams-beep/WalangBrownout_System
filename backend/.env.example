# =============================================================================
# Walang Brownout Appliances — Laravel REST API
# Environment Configuration Template
#
# HOW TO USE:
#   Local dev  → copy to .env and fill in your values
#   Railway    → set each variable in the Railway service Variables panel
#
# NEVER commit the real .env file — it is in .gitignore
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="WalangBrownout Backend"
APP_ENV=local                          # local | production
APP_KEY=                               # Run: php artisan key:generate
APP_DEBUG=true                         # Set false in production
APP_URL=http://127.0.0.1:8000          # Railway will set to https://<domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug                        # Set to error in production

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (SQLite — zero-config, works out of the box)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# RAILWAY PRODUCTION (uncomment and fill from Railway MySQL service variables)
# DB_CONNECTION=mysql
# DB_HOST=${MYSQLHOST}                 # Railway internal hostname
# DB_PORT=${MYSQLPORT}                 # Usually 3306
# DB_DATABASE=${MYSQLDATABASE}
# DB_USERNAME=${MYSQLUSER}
# DB_PASSWORD=${MYSQLPASSWORD}

# ── CORS & Frontend URL ───────────────────────────────────────────────────────
# Used by config/cors.php to allow the React SPA to call this API.
# Local: http://localhost:5173 (Vite dev server default)
# Railway: set to your deployed frontend URL
FRONTEND_URL=http://localhost:5173

# ── Sanctum ───────────────────────────────────────────────────────────────────
# For stateless Bearer token auth (React SPA), no additional Sanctum config needed.
# SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Cache / Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail (not used in this system — placeholder) ──────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@walangbrownout.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Railway Deployment ────────────────────────────────────────────────────────
# These are auto-injected by Railway — do not set manually:
# RAILWAY_PUBLIC_DOMAIN
# RAILWAY_ENVIRONMENT
# PORT
